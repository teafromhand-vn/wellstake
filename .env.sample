# Copy to .env and fill in your own values. Never commit the real .env.
# OP Mainnet
CHAIN_ID=10
RPC_URL=https://optimism-rpc.publicnode.com

# Deployer (manager) private key. Must hold ETH for gas. Keep secret.
PRIVATE_KEY=0xyour_deployer_private_key_here

# Roles
MANAGER=0xYourManagerAddress
VAULT_WALLET=0xYourVaultWalletAddress

# Settlement token (native USDC on OP Mainnet)
USDC=0x0b2C639c533813f4Aa9D7837CAf62653d097Ff85

# Share token metadata
TOKEN_NAME=Wellstake Beta Vault
TOKEN_SYMBOL=wskBV

# Optional: if manager != deployer, the key that will call setVault (link step).
# MANAGER_PRIVATE_KEY=0x...
